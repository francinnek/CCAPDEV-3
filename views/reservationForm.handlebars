<!--- Form --->
<form>
    <div class="container">
        <h3 class="section-title primary">Personal Information</h3>
        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name">
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email address</label>
            <input type="email" class="form-control" id="email" aria-describedby="emailHelp">
            <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
        </div>
        <div class="mb-3">
            <label for="passportId" class="form-label">Passport Number</label>
            <input type="text" class="form-control" id="passportId">
        </div>
        <hr class="my-5"><h3 class="section-title secondary">Preferences</h3>
        <p class="meal-option"><br>Meal Option</p>
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Select a meal
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="#" data-value="Standard">Standard</a></li>
                <li><a class="dropdown-item" href="#" data-value="Vegetarian">Vegetarian</a></li>
                <li><a class="dropdown-item" href="#" data-value="Religious">Religious</a></li>
                <li><a class="dropdown-item" href="#" data-value="Medical">Medical</a></li>
                <li><a class="dropdown-item" href="#" data-value="Children's Meal">Children's Meal</a></li>
            </ul>
            <div class="form-check mt-3 mb-5">
                <label class="form-label xtra-name" for="extraBaggage">
                    Extra Baggage ($60 each)
                </label>
                <input class="form-control xtrabaggage" type="number" value="0" min="0" id="extraBaggage">
            </div>
        </div>
    </div>
</form>

