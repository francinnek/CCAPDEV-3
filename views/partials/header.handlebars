<header>
    <div class="header-container">
        <div class="brand">
            <img src="/sprites/dlsu-airlines.png" class="header-logo" alt="DLSU Airlines Logo">
            <h1>DLSU Airlines</h1>
        </div>
        <nav>
            <a href="/flights/search" class="{{#if active.search}}active{{/if}}">Search Flights</a>
            <a href="/flights/avail" class="{{#if active.book}}active{{/if}}">Book Flight</a>
            <a href="/reservations" class="{{#if active.reservations}}active{{/if}}">My Reservations</a>
            <a href="#" class="{{#if active.profile}}active{{/if}} navbar-nav-link" 
               data-bs-toggle="offcanvas" 
               data-bs-target="#profileOffcanvas" 
               aria-controls="profileOffcanvas">Profile</a>
        </nav>
    </div>
</header>

{{> profileToggle}}

