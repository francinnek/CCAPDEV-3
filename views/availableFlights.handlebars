<div class="container logo-container text-center py-5">
  <img src="/sprites/dlsu-airlines.png" class="logo-image img-fluid mb-4" alt="DLSU Airlines">
  <p id="page-text"><br><br>DLSU Airline's list of available flights</p>
</div>

<div class="flights-container container px-4 py-5">
  {{#if flights.length}}
    {{#each flights}}
      <div class="card flight-card" data-origin="{{this.origin}}" data-destination="{{this.destination}}">
        <div class="route">
          <span class="country">{{this.origin}}</span> → 
          <span class="country">{{this.destination}}</span>
        </div>
        <h6 class="card-subtitle flight-details">{{this.flightNumber}} -- {{this.airline}}</h6>
        <div class="card-text">
          <div class="flight-info">
            <p>Departure: <br>{{this.departure_date}} | {{this.departure_time}}</p>
            <p>Arrival: <br>{{this.arrival_date}} | {{this.arrival_time}}</p>
          </div>
        </div>
        <p class="card-text flight-price">${{this.price}}</p>
        <div class="text-center mb-3">
          <a href="/form?price={{this.price}}&origin={{this.origin}}&destination={{this.destination}}&airline={{this.airline}}&flightDeparture={{this.departure_date}}&flightArrival={{this.arrival_date}}" class="btn btn-success book-now" 
                  data-flight-id="{{this._id}}"
                  data-origin="{{this.origin}}"
                  data-destination="{{this.destination}}"
                  data-flight-number="{{this.flightNumber}}"
                  data-airline="{{this.airline}}"
                  data-departure="{{this.departure_date}} {{this.departure_time}}"
                  data-arrival="{{this.arrival_date}} {{this.arrival_time}}"
                  data-price="{{this.price}}">
            Book Now
          </a>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div class="alert alert-info" role="alert">
      No flights found.
    </div>
  {{/if}}
</div>

<script>
$(document).ready(function() {
  // Extract search context from the URL so we can keep it across pages
  const urlParams = new URLSearchParams(window.location.search);
  const searchOrigin = urlParams.get('origin');
  const searchDestination = urlParams.get('destination');
  const searchDate = urlParams.get('departure');
  const passengers = urlParams.get('passengers');

  if (searchOrigin && searchDestination) {
    $('#page-text').html(`<br><br>Available flights from ${searchOrigin} to ${searchDestination}`);

    // Client-side filtering as a safety net when the server returned a broader list
    $('.flight-card').each(function() {
      const cardOrigin = ($(this).data('origin') || '').toString();
      const cardDestination = ($(this).data('destination') || '').toString();
      const originMatch = cardOrigin.toLowerCase().includes(searchOrigin.toLowerCase());
      const destMatch = cardDestination.toLowerCase().includes(searchDestination.toLowerCase());
      $(this).toggle(originMatch && destMatch);
    });
  }

  if ($('.flight-card:visible').length === 0) {
    $('.flights-container').prepend(`
      <div class="alert alert-info" role="alert">
        No flights found for your search criteria. Please try different dates or destinations.
      </div>
    `);
  }

  $(document).on('click', '.book-now', function(e) {
    e.preventDefault();

    // Gather flight data from the clicked button's data attributes (fallback to card data if needed)
    const button = $(this);
    const card = button.closest('.flight-card');
    const originAttr = button.attr('data-origin') || card.data('origin') || '';
    const destinationAttr = button.attr('data-destination') || card.data('destination') || '';
    const airlineAttr = button.attr('data-airline') || card.find('.flight-details').text().trim() || '';
    const flightNumberAttr = button.attr('data-flight-number') || '';
    const departureAttr = button.attr('data-departure') || card.find('.flight-info p').first().text().replace('Departure: ', '').trim() || '';
    const arrivalAttr = button.attr('data-arrival') || card.find('.flight-info p').last().text().replace('Arrival: ', '').trim() || '';
    const priceAttr = button.attr('data-price') || card.find('.flight-price').text().replace('$', '').trim() || '';

    const params = new URLSearchParams({
      origin: originAttr,
      destination: destinationAttr,
      airline: airlineAttr,
      flightNumber: flightNumberAttr,
      flightDeparture: departureAttr,
      flightArrival: arrivalAttr,
      price: priceAttr
    });

    if (searchDate) {
      params.set('searchDeparture', searchDate);
    }
    if (passengers) {
      params.set('passengers', passengers);
    }

    window.location.href = `/form?${params.toString()}`;
  });
});
</script>