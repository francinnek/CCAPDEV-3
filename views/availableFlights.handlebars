<div class="container logo-container text-center py-5">
  <img src="/sprites/dlsu-airlines.png" class="logo-image img-fluid mb-4" alt="DLSU Airlines">
  <p id="page-text"><br><br>DLSU Airline's list of available flights</p>
</div>

<div class="flights-container container px-4 py-5">
  {{#if flights.length}}
    {{#each flights}}
      <div class="card flight-card" data-origin="{{this.origin}}" data-destination="{{this.destination}}">
        <div class="route">
          <span class="country">{{this.origin}}</span> → 
          <span class="country">{{this.destination}}</span>
        </div>
        <h6 class="card-subtitle flight-details">{{this.flightNumber}} -- {{this.airline}}</h6>
        <div class="card-text">
          <div class="flight-info">
            <p>Departure: <br>{{this.departure_date}} | {{this.departure_time}}</p>
            <p>Arrival: <br>{{this.arrival_date}} | {{this.arrival_time}}</p>
          </div>
        </div>
        <p class="card-text flight-price">${{this.price}}</p>
        <div class="text-center mb-3">
          <a href="/form" class="btn btn-success book-now" 
                  data-flight-id="{{this._id}}"
                  data-origin="{{this.origin}}"
                  data-destination="{{this.destination}}"
                  data-flight-number="{{this.flightNumber}}"
                  data-airline="{{this.airline}}"
                  data-departure="{{this.departure_date}} {{this.departure_time}}"
                  data-arrival="{{this.arrival_date}} {{this.arrival_time}}"
                  data-price="{{this.price}}">
            Book Now
          </a>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div class="alert alert-info" role="alert">
      No flights found.
    </div>
  {{/if}}
</div>

<script>
$(document).ready(function() {
  // Get search parameters from URL
  const urlParams = new URLSearchParams(window.location.search);
  const searchOrigin = urlParams.get('origin');
  const searchDestination = urlParams.get('destination');
  const searchDate = urlParams.get('departure');
  const passengers = urlParams.get('passengers');

  // Update page title with search criteria
  if (searchOrigin && searchDestination) {
    $('#page-text').html(`<br><br>Available flights from ${searchOrigin} to ${searchDestination}`);
    
    // Filter flights based on search criteria (client-side filtering as fallback)
    $('.flight-card').each(function() {
      const cardOrigin = $(this).data('origin');
      const cardDestination = $(this).data('destination');
      
      if (cardOrigin && cardDestination) {
        const originMatch = cardOrigin.toLowerCase().includes(searchOrigin.toLowerCase());
        const destMatch = cardDestination.toLowerCase().includes(searchDestination.toLowerCase());
        
        $(this).toggle(originMatch && destMatch);
      }
    });
  }

<script>
  $(document).ready(function() {
    // Get search parameters from URL
    const urlParams = new URLSearchParams(window.location.search);
    const searchOrigin = urlParams.get('origin');
    const searchDestination = urlParams.get('destination');
    const searchDate = urlParams.get('departure');
    const passengers = urlParams.get('passengers');

    // Update page title with search criteria
    if (searchOrigin && searchDestination) {
        $('#page-text').html(`<br><br>Available flights from ${searchOrigin} to ${searchDestination}`);
    }

    // Filter flight cards based on search criteria
    $('.flight-card').each(function() {
        const routeText = $(this).find('.route').text();
        const originMatch = routeText.toLowerCase().includes(searchOrigin?.toLowerCase());
        const destMatch = routeText.toLowerCase().includes(searchDestination?.toLowerCase());

        // Show only matching flights
        if (searchOrigin && searchDestination) {
            $(this).toggle(originMatch && destMatch);
        }

        // Append Book Now button if not already there
        if ($(this).find('.book-now').length === 0) {
            $(this).append(`
                <div class="text-center mb-3">
                    <button class="btn btn-success book-now">Book Now</button>
                </div>
            `);
        }
    });

    // Show message if no flights found
    if ($('.flight-card:visible').length === 0) {
        $('.flights-container').prepend(
            `<div class="alert alert-info" role="alert">
                No flights found for your search criteria. Please try different dates or destinations.
            </div>`
        );
    }

    // Book Now button click event
    $(document).on('click', '.book-now', function(e) {
        e.stopPropagation(); // Prevent any parent click events

        // Get flight details from card
        const card = $(this).closest('.flight-card');
        const route = card.find('.route').text().trim();
        const airline = card.find('.flight-details').text().trim();
        const departure = card.find('.flight-info p').first().text().replace('Departure: ', '').trim();
        const arrival = card.find('.flight-info p').last().text().replace('Arrival: ', '').trim();
        const price = card.find('.flight-price').text().replace('$', '').trim();

        // Build URL parameters
        const params = new URLSearchParams({
            origin: searchOrigin,
            destination: searchDestination,
            searchDeparture: searchDate,
            passengers: passengers,
            route: route,
            airline: airline,
            flightDeparture: departure,
            flightArrival: arrival,
            price: price
        });

        // Redirect to reservation form
        window.location.href = `reservationForm?${params.toString()}`;
    });
});
</script>