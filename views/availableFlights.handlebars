<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container logo-container text-center py-5">
  <img src="/sprites/dlsu-airlines.png" class="logo-image img-fluid mb-4" alt="DLSU Airlines">
  <p id="page-text"><br><br>DLSU Airline's list of available flights</p>
</div>

<div class="flights-container container px-4 py-5">
  {{#if flights.length}}
    {{#each flights}}
      <div class="card flight-card" data-origin="{{this.origin}}" data-destination="{{this.destination}}">
        <div class="route">
          <span class="country">{{this.origin}}</span> → 
          <span class="country">{{this.destination}}</span>
        </div>
        <h6 class="card-subtitle flight-details">{{this.flightNumber}} -- {{this.airline}}</h6>
        <div class="card-text">
          <div class="flight-info">
            <p>Departure: <br>{{this.departure_date}} | {{this.departure_time}}</p>
            <p>Arrival: <br>{{this.arrival_date}} | {{this.arrival_time}}</p>
          </div>
        </div>
        <p class="card-text flight-price">${{this.price}}</p>
        <div class="text-center mb-3">
          <a href="/form" class="btn btn-success book-now" 
                  data-flight-id="{{this._id}}"
                  data-origin="{{this.origin}}"
                  data-destination="{{this.destination}}"
                  data-flight-number="{{this.flightNumber}}"
                  data-airline="{{this.airline}}"
                  data-departure="{{this.departure_date}} {{this.departure_time}}"
                  data-arrival="{{this.arrival_date}} {{this.arrival_time}}"
                  data-price="{{this.price}}">
            Book Now
          </a>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div class="alert alert-info" role="alert">
      No flights found.
    </div>
  {{/if}}
</div>

<script>
$(document).ready(function() {
    // Get search parameters from URL
    const urlParams = new URLSearchParams(window.location.search);
    const searchOrigin = urlParams.get('origin');
    const searchDestination = urlParams.get('destination');

    // Update page title with search criteria
    if (searchOrigin && searchDestination) {
        $('#page-text').html(`<br><br>Available flights from ${searchOrigin} to ${searchDestination}`);
    }

    // Book Now button click event
    $(document).on('click', '.book-now', function(e) {
        e.preventDefault();

        const btn = $(this);
        const params = new URLSearchParams({
            origin: btn.data('origin'),
            destination: btn.data('destination'),
            airline: btn.data('airline'),
            flightDeparture: btn.data('departure'),
            flightArrival: btn.data('arrival'),
            price: btn.data('price')
        });

        window.location.href = `/form?${params.toString()}`;
    });
});
</script>