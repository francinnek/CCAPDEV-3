<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<div class="reservations-container">
    <h2 id="page-title">My Reservations</h2>

    <div id="booking-list">
        {{#if bookings}}
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each bookings}}
                    <tr>
                        <td>{{@index}}</td>
                        <td>{{this.origin}}</td>
                        <td>{{this.destination}}</td>
                        <td>
                            <button class="btn btn-primary view-details" data-id="{{this._id}}">View Details</button>
                            <button class="btn btn-danger cancel-booking" data-id="{{this._id}}">Cancel</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        {{else}}
            <p class="text-center">No reservations found.</p>
        {{/if}}
    </div>

    <div id="booking-details" style="display: none;">
        <div id="details-content"></div>
        <button id="backToList" class="btn btn-secondary mt-3">Back to List</button>
    </div>
</div>

<script>
$(document).ready(function () {
    // View Details button
    $(document).on("click", ".view-details", function () {
        const id = $(this).data("id");
        console.log('View details clicked for ID:', id);
        
        $.get('/bookings/' + id)
            .done(function(booking) {
                console.log('Booking details:', booking);
                $("#details-content").html(`
                    <div class="card p-3">
                        <h5 class="card-title text-success">Reservation Details</h5>
                        <p><strong>Passenger:</strong> ${booking.name}</p>
                        <p><strong>Email:</strong> ${booking.email}</p>
                        <p><strong>Seat:</strong> ${booking.selectedSeat}</p>
                        <p><strong>Route:</strong> ${booking.origin} to ${booking.destination}</p>
                        <p><strong>Departure:</strong> ${booking.flightDeparture}</p>
                        <p><strong>Status:</strong> <span class="badge bg-success">Confirmed</span></p>
                    </div>
                `);
                $("#booking-list").hide();
                $("#booking-details").show();
                $("#page-title").text("Reservation Details");
            })
            .fail(function(xhr, status, error) {
                console.error('Error loading details:', error);
                alert('Error loading details: ' + error);
            });
    });

    // Cancel Booking button 
    $(document).on("click", ".cancel-booking", function () {
        if (!confirm('Are you sure you want to cancel this booking?')) return;
        
        const id = $(this).data("id");
        console.log('Cancel clicked for ID:', id);
        
       
        $.post('/reservations/' + id + '/cancel')
            .done(function() {
                alert('Booking cancelled successfully!');
                location.reload(); // Reload to show updated list
            })
            .fail(function(xhr, status, error) {
                console.error('Error cancelling booking:', error);
                alert('Error cancelling booking: ' + error);
            });
    });

    // Back to List button
    $("#backToList").click(function () {
        $("#booking-list").show();
        $("#booking-details").hide();
        $("#page-title").text("My Reservations");
    });
});
</script>