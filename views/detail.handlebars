<div class="reservations-container">
    <h2>Reservation Details</h2>
    
    <div class="card p-3">
        <h5 class="card-title text-success">Reservation Details</h5>
        <p><strong>Passenger:</strong> {{booking.name}}</p>
        <p><strong>Email:</strong> {{booking.email}}</p>
        <p><strong>Seat:</strong> {{booking.selectedSeat}}</p>
        <p><strong>Route:</strong> {{booking.origin}} to {{booking.destination}}</p>
        <p><strong>Departure:</strong> {{booking.flightDeparture}}</p>
        <p><strong>Status:</strong> <span class="badge bg-success">Confirmed</span></p>
        <div class="mt-3">
            <a href="/reservations{{#if profile.username}}?user={{profile.username}}{{/if}}" class="btn btn-secondary">Back to List</a>
            <a href="/bookings/{{booking._id}}/edit{{#if profile.username}}?user={{profile.username}}{{/if}}" class="btn btn-warning">Modify Reservation</a>
            <form action="/reservations/{{booking._id}}/cancel" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger" 
                        onclick="return confirm('Are you sure you want to cancel this booking?')">
                    Cancel Reservation
                </button>
            </form>
        </div>
    </div>
</div>